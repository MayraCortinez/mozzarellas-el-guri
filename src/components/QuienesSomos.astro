---
// Componente Historia: Texto a la Izquierda y Filtro Azul de Fondo Regulable
const datosHistoria = {
  seccion: "Quiénes Somos",
  titulo: "Tradición familiar",
  parrafo1: "Con más de 20 años trabajando en la cuenca lechera de Buenos Aires. Conocemos el día a día y sabemos que lo más importante para tu negocio es la constancia y la confianza.",
  parrafo2: "",
  parrafo3: "Por eso te facilitamos el stock, sin intermediarios y a partir de solo 10 kg."
};

const bgImage = "/images/4.png";
---

<section 
  id="quienes-somos" 
  class="relative py-var(--space-section) px-8 bg-cover bg-center bg-no-repeat bg-fixed-parallax text-stone-900 border-t border-b border-stone-200/60 scroll-mt-20 overflow-hidden"
  style={`background-image: url('${bgImage}');`}
>
  
  <!-- 🎛️ CAPA DE FILTRO AZUL REGULABLE (Overlay) -->
  <!-- Podés cambiar la opacidad (bg-brand-azul/40, bg-brand-azul/60, etc.) o usar un color inline para tunear el tono exacto de azul -->
  <div class="absolute inset-0 bg-brand-titulos/40 backdrop-contrast-100 z-0"></div>

  <!-- Grilla Invertida: Texto a la Izquierda en Desktop -->
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-8 items-center relative z-10 w-full">
    
    <!-- COLUMNA IZQUIERDA: Ahora contiene la Tarjeta Flotante (Ocupa 7 de 12 columnas en Desktop) -->
    <div class="col-span-1 md:col-span-7 flex flex-col justify-center py-6 md:py-6">
      
      <!-- CONTENEDOR CON SOMBRA Y FILTRO AISLADOS (Glassmorphism Ajustado) -->
      <div class="bg-brand-titulos/50 backdrop-blur-lg border border-white/20 p-6 sm:p-10 rounded-[2.5rem] shadow-xl shadow-stone-950/10 max-w-xl mx-auto md:mx-0 text-center md:text-left space-y-5 relative z-10">
        
        <span class="text-stone-100/80 text-xs font-black uppercase tracking-widest bg-brand-titulos/80 backdrop-blur-xs px-4 py-1.5 rounded-full inline-block border border-white/10">
          {datosHistoria.seccion}
        </span>
        
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-stone-200 leading-tight">
          {datosHistoria.titulo}
        </h2>
        
        <div class="text-stone-100/70 text-sm sm:text-base space-y-4 leading-relaxed font-semibold">
          <p>{datosHistoria.parrafo1}</p>
          <p>{datosHistoria.parrafo2}</p>
          <p>
            {datosHistoria.parrafo3.split('a partir de solo 10 kg.')}
            <strong class="text-stone-100 font-black px-2 py-0.5 rounded-md inline-block">a partir de solo 10 kg</strong>.
          </p>
        </div>
        
      </div>

    </div>

    <!-- COLUMNA DERECHA: Vacía en Desktop (Ocupa 5 de 12 columnas) para que se aprecie el Parallax Azulado -->
    <div class="hidden md:block md:col-span-5 pointer-events-none"></div>

  </div>
</section>

<style>
  /* Parallax Nativo mediante CSS para computadoras */
  .bg-fixed-parallax {
    background-attachment: fixed;
  }

  /* Desactivar el efecto 'fixed' en pantallas táctiles móviles para garantizar suavidad total */
  @media (pointer: coarse) {
    .bg-fixed-parallax {
      background-attachment: scroll;
    }
  }
</style>
