---
// Componente Historia: Datos Aislados y Estructura Cinematográfica Parallax 3D
const datosHistoria = {
  seccion: "Quiénes Somos",
  titulo: "Tradición familiar y palabra recta",
  parrafo1: "Somos una empresa familiar que lleva más de 20 años trabajando en la cuenca lechera de Buenos Aires. Conocemos el día a día de la gastronomía y sabemos que lo más importante para tu negocio es la constancia y la confianza.",
  parrafo2: "Hoy llegamos con reparto propio a Capital Federal, Gran Buenos Aires y la Costa Atlántica, además de contar con dos puntos de entrega fijos en AMBA.",
  parrafo3: "No nos manejamos como una corporación fría: somos tus vecinos de la zona trabajando para tu comercio. Por eso te facilitamos el stock entregándote las muzzarellas directo en la puerta de tu local, sin intermediarios y a partir de solo 10 kg."
};

// Ruta de la imagen de fondo unificada para mantener la coherencia
const bgImage = "/images/4.png";
---

<section 
  id="quienes-somos" 
  class="relative py-(--space-section) px-4 bg-cover bg-center bg-no-repeat bg-fixed-parallax text-white border-t border-b border-stone-200/60 scroll-mt-20 overflow-hidden"
  style={`background-image: url('${bgImage}');`}
>
  
  <!-- Filtro oscuro (Overlay) constante para asegurar legibilidad milimétrica en cualquier pantalla -->
  <div class="absolute inset-0 sm:bg-stone-950/75 z-0"></div>

  <!-- Grilla Asimétrica de 12 Columnas (Layout Cinematográfico) -->
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-8 items-center relative z-10 w-full">
    
    <!-- COLUMNA IZQUIERDA: Vacía en Desktop (Ocupa 5 de 12 columnas) para que se aprecie el Parallax del Fondo -->
    <div class="hidden md:block md:col-span-5 pointer-events-none"></div>

    <!-- COLUMNA DERECHA: El bloque de información (Ocupa 7 de 12 columnas en Desktop, 100% en Mobile) -->
    <div class="col-span-1 md:col-span-7 flex flex-col justify-center py-4 md:py-8 md:pl-8 text-center md:text-left">
      
      <!-- Contenedor del texto (UX Clean) -->
      <div class="space-y-5 max-w-xl mx-auto md:mx-0">
        <span class="text-brand-azul text-xs font-black uppercase tracking-widest bg-white/10 backdrop-blur-xs px-4 py-1.5 rounded-full border border-white/10 inline-block">
          {datosHistoria.seccion}
        </span>
        
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-white leading-tight">
          {datosHistoria.titulo}
        </h2>
        
        <div class="text-stone-300 text-sm sm:text-base space-y-4 leading-relaxed font-medium">
          <p>{datosHistoria.parrafo1}</p>
          <p>{datosHistoria.parrafo2}</p>
          <p>
            {datosHistoria.parrafo3.split('a partir de solo 10 kg.')[0]}
            <strong class="text-white font-black">a partir de solo 10 kg</strong>.
          </p>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  /* Parallax Nativo mediante CSS para computadoras */
  .bg-fixed-parallax {
    background-attachment: fixed;
  }

  /* Desactivar el efecto 'fixed' en pantallas táctiles móviles para garantizar suavidad total */
  @media (pointer: coarse) {
    .bg-fixed-parallax {
      background-attachment: scroll;
    }
  }
</style>
