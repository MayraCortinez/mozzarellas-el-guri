---
// Componente de Sucursales / Puntos Fijos en AMBA
const sucursales = [
  {
   nombre: "Centro de Distribución Mayorista (Capital Federal)",
    direccion: "Bermúdez 1330 (Esq. Magariños Cervantes), CABA",
    detalle: "Nuestra base logística principal y depósito central de abastecimiento gastronómico.",
    horario: "Lunes a Viernes de 06:00 a 14:00 hs",
    imagen: "/images/13.jpeg" // Puedes usar una foto limpia de cajas/logística
  },
  {
    nombre: "Envíos sin costo San Miguel, José C. Paz, Muñiz y Bella Vista.",
    direccion: "Av. Sesquicentenario 3067, Pablo Nogués",
    detalle: "Local comercial de atención directa, fiambrería y retiro mayorista de mercadería.",
    horario: "Lunes a Sábado de 08:00 a 20:00 hs",
    imagen: "/images/14.jpeg"
  }
];
---

<section id="sucursales" class="py-(--space-section) px-4 bg-gradient-azul bg-fixed border-t border-b border-stone-200/60 scroll-mt-20">
  <div class="max-w-5xl mx-auto space-y-12">
    
    <!-- Encabezado -->
    <div class="text-center max-w-2xl mx-auto pt-6 space-y-4">
      
      <h2 class="text-3xl text-white font-black tracking-tight sm:text-4xl">
        Puntos de Entrega en AMBA
      </h2>
      <p class="text-stone-400 text-sm sm:text-base">
        Bases logísticas estratégicas para agilizar el abastecimiento mayorista de su negocio.
      </p>
    </div>

    <!-- Grilla Simétrica de 2 Columnas -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {sucursales.map((suc) => (
        <div class="bg-white border border-stone-200/80 rounded-4xl overflow-hidden shadow-xs flex flex-col justify-between group">
          
          <!-- Contenedor Imagen Estética -->
          <div class="h-48 overflow-hidden bg-stone-100 relative">
            <img 
              src={suc.imagen} 
              alt={suc.nombre} 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-103"
            />
            <div class="absolute inset-0 bg-linear-to-t from-stone-900/10 to-transparent"></div>
          </div>

          <!-- Información Limpia -->
          <div class="p-6 md:p-8 space-y-4 flex-1 flex flex-col justify-between">
            <div class="space-y-2">
              <h3 class="text-xl font-black text-brand-titulos tracking-tight">{suc.nombre}</h3>
              <p class="text-sm text-stone-600 leading-relaxed font-medium">📍 {suc.direccion}</p>
            </div>

            <div class="pt-4 border-t border-stone-100 space-y-1 text-xs text-stone-400 font-medium">
              <p>🕒 {suc.horario}</p>
              <p>📞 Contacto Central: {suc.telefono}</p>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
