---
// Componente de Catálogo Premium - Inspirado en Nuday UX/CRO
const productos = [
  {
    marca: "El Guri",
    linea: "Línea Selección Tradicional",
    etiqueta: "Marca Registrada",
    colorStyle: "from-brand-azul/5 to-brand-azul/10 border-brand-azul/15 text-brand-azul bg-brand-azul",
    badgeBg: "bg-brand-azul",
    descripcion: "Nuestra presentación insignia en bolsón. Desarrollada bajo recetas tradicionales con un hilado de alta elasticidad, ideal para pizzerías de estilo clásico argentino.",
    atributos: ["100% Leche Pura", "Hilado Tradicional", "Formato Bolsón"],
    imagen: "/images/1.png",
    giro: "group-hover:rotate-3"
  },
  {
    marca: "Kezic",
    linea: "Línea Tradición Argentina",
    etiqueta: "Premium Vacío",
    colorStyle: " border-brand-rojo/15 text-brand-rojo bg-brand-rojo",
    badgeBg: "bg-brand-rojo",
    descripcion: "Hormas seleccionadas con envasado al vacío de origen. Garantiza una frescura prolongada y un fundido uniforme sin pérdida de líquido, excelente para milanesas y platos gourmet.",
    atributos: ["Envasado al Vacío", "Cero Pérdida de Suero", "Sabor Suave"],
    imagen: "/images/3.png",
    giro: "group-hover:-rotate-3"
  },
  {
    marca: "Lácteos Pizzio",
    linea: "Línea Cilindro Gastronómico",
    etiqueta: "Alto Rendimiento",
    colorStyle: "from-brand-verde/5 to-brand-verde/10 border-brand-verde/15 text-brand-verde bg-brand-verde",
    badgeBg: "bg-brand-verde",
    descripcion: "Formato diseñado específicamente para el procesado y rallado rápido en cocinas industriales. Máximo rendimiento operativo y fundido rápido para despachos de alto volumen.",
    atributos: ["Rallado Veloz", "Especial Gastronomía", "Formato Cilindro"],
    imagen: "/images/2.png",
    giro: "group-hover:rotate-2"
  }
];
---

<section id="productos" class="py-(--space-section) px-4 bg-brand-fondo scroll-mt-20">
  <div class="max-w-5xl mx-auto space-y-12">
    
    <!-- Encabezado Corto -->
    <div class="space-y-2 text-center mx-auto max-w-xl">
      <span class="text-brand-azul text-xs font-black uppercase tracking-widest"> </span>
      <h2 class="text-4xl font-black text-brand-titulos tracking-tight sm:text-4xl">Nuestras Líneas</h2>
    </div>

    <!-- Bloques de Producto Limpios -->
  <!-- BLOQUE DE PRODUCTOS ESTILO NUDAY + CARD ASIMÉTRICA TAILWIND -->
<div class="space-y-12">
  {productos.map((prod) => (
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 items-center bg-white p-6 md:p-8 rounded-[2.5rem] border border-stone-200/80 shadow-xs group">
      
      <!-- COLUMNA PRODUCTO RECONFIGURADA (Imagen Izquierda + Etiqueta Encastrada) -->
      <div class="md:col-span-5 relative w-full overflow-hidden rounded-ss-[2.5rem] rounded-ee-[2.5rem] border border-stone-100 bg-stone-50/50 p-6 min-h-60 sm:min-h-70 flex items-center justify-center">
        
        <!-- Tu primer SPAN: Convertido en la etiqueta encastrada en la esquina superior izquierda -->
        <span class={`absolute -top-px -left-px rounded-ss-[2.5rem] rounded-ee-3xl text-[10px] font-black uppercase tracking-widest text-white px-6 py-3.5 ${prod.badgeBg} border-b border-r border-white/10 z-20`}>
          {prod.etiqueta}
        </span>

        <!-- Brillo esférico interno detrás del queso -->
        <div class={`absolute w-36 h-36 sm:w-44 sm:h-44 rounded-full blur-2xl opacity-15 bg-current ${prod.colorStyle.split(' ')[0]}`}></div>
        
        <!-- Imagen del queso con levitación al pasar el mouse -->
        <img 
          src={prod.imagen} 
          alt={`Muzzarella ${prod.marca}`} 
          class={`w-40 sm:w-48 h-auto object-contain drop-shadow-md transition-transform duration-500 ${prod.giro} group-hover:scale-105 relative z-10`}
        />
      </div>

      <!-- COLUMNA INFORMACIÓN (Se mantiene limpia a la derecha, 7 columnas) -->
      <div class="md:col-span-7 space-y-4">
        <p class="text-stone-400 text-xs font-bold uppercase tracking-wide">{prod.linea}</p>
        
        <h3 class="text-2xl sm:text-3xl font-black text-brand-titulos tracking-tight">
          {prod.marca}
        </h3>

        <p class="text-brand-texto text-sm sm:text-base leading-relaxed max-w-xl">
          {prod.descripcion}
        </p>

        <!-- Atributos Educativos Minimalistas -->
        <div class="flex flex-wrap gap-2 pt-1">
          {prod.atributos.map((attr) => (
            <span class="bg-stone-50 border border-stone-200/60 text-stone-600 text-xs font-semibold px-3 py-1.5 rounded-xl inline-flex flex-row gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
  <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
</svg>

               {attr}
            </span>
          ))}
        </div>
      </div>

    </div>
  ))}
</div>


  </div>
</section>
