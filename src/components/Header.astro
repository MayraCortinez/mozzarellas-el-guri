---
// Componente Header con Menú Hamburguesa Nativo
---
<header id="header" class="sticky top-0 z-50 bg-white backdrop-blur-md border-b border-stone-200/60 px-4 py-4">
  <div class="max-w-5xl mx-auto flex justify-between items-center">
    
    <!-- Logo -->
    <a href="#" class="flex items-center gap-2 font-black text-stone-900 tracking-tight">
       <img class="h-16" src="/images/logo.jpg" alt="">
        <span class="text-brand-titulos text-xl"> EL GURI</span> 
    </a>

    <!-- Menú Desktop -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-brand-titulos/70">
      <a href="#productos" class="hover:text-brand-azul transition-colors">Productos</a>
      <a href="#sucursales" class="hover:text-brand-azul transition-colors">Sucursales</a>
      <a href="#quienes-somos" class="hover:text-brand-azul transition-colors">Quiénes Somos</a>
      <a href="#contacto" class="bg-brand-azul text-white px-5 py-2 rounded-full text-xs font-bold hover:bg-opacity-90 transition-all">Contacto</a>
    </nav>

    <!-- Botón Hamburguesa Mobile -->
    <button id="menu-toggle" class="md:hidden text-stone-900 p-1 focus:outline-none" aria-label="Abrir menú">
      <svg xmlns="http://w3.org" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
    </button>

  </div>

  <!-- Menú Desplegable Mobile -->
  <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 w-full bg-brand-fondo border-b border-stone-200 shadow-lg px-6 py-6 space-y-4 font-semibold text-stone-700">
    <a href="#productos" class="block hover:text-brand-azul py-1">Productos</a>
    <a href="#sucursales" class="block hover:text-brand-azul py-1">Sucursales</a>
    <a href="#quienes-somos" class="block hover:text-brand-azul py-1">Quiénes Somos</a>
    <a href="#contacto" class="block bg-brand-azul text-white text-center py-2.5 rounded-xl text-sm font-bold">Contacto</a>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Cerrar menú al hacer clic en un enlace
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => menu.classList.add('hidden'));
  });
</script>
