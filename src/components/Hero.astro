<section class="overflow-hidden bg-blue-50 sm:grid sm:grid-cols-2 py-16 items-center relative">
  <div class="p-8 md:p-12 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-xl text-center ltr:sm:text-left rtl:sm:text-right">
    
      <div class="space-y-6 text-center md:text-left max-w-prose">
        <div class="space-y-4">
          <!-- Título Gigante y Minimalista -->
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tighter text-brand-titulos leading-[1.05]">
            Mozzarella <br class="hidden sm:inline" />
            de la fábrica a tu negocio.
          </h1>

          <!-- Subtítulo Limpio -->
          <p class="text-stone-500 text-base sm:text-lg lg:text-xl font-medium leading-relaxed max-w-md mx-auto md:mx-0">
            Abasteciendo negocios desde la cuenca lechera con logística propia, <strong class="text-brand-azul font-black">a partir de solo 10 kg</strong> en Capital, AMBA y la Costa Atlántica.
          </p>
        </div>
        
        <!-- BOTÓN DESKTOP: Se oculta en mobile (hidden) y aparece en computadoras (md:inline-flex) -->
        <div class="pt-4 hidden md:block">
          <a 
            href="https://wa.me." 
            class="relative inline-flex items-center justify-center bg-brand-titulos text-white px-8 py-4 rounded-2xl
                   font-bold text-base sm:text-lg tracking-wide font-['Outfit',sans-serif]
                   shadow-[0_4px_0_0_#00335c,0_10px_20px_rgba(0,75,135,0.2)]
                   border-t border-white/20
                   transition-all duration-150 ease-out
                   hover:translate-y-px hover:shadow-[0_3px_0_0_#00335c,0_8px_15px_rgba(0,75,135,0.15)]
                   active:translate-y-1 active:shadow-[0_0_0_0_#00335c,0_0_0_rgba(0,0,0,0)]"
          >
            <span class="absolute inset-0 bg-linear-to-b from-white/12 to-transparent rounded-2xl pointer-events-none"></span>
            <span class="relative z-10 flex items-center gap-2">
              Consultar Reparto por WhatsApp 
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-white shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
              </svg>
            </span>
          </a>
        </div>
      </div>
      
    </div>
  </div>

  <!-- COLUMNA DERECHA (Contenedor de Imagen + Sombra) -->
  <div class="relative w-full h-full sm:h-full flex items-center justify-center">
    <img
      alt="Queso Muzzarella El Guri"
      src="images/5.png"
      class="w-full h-full object-contain max-w-7xl sm:max-w-md animate-float drop-shadow-[0_20px_30px_rgba(0,0,0,0.12)] relative z-10"
    />
    <!-- Sombra responsiva colocada de forma absoluta abajo de la foto -->
    <div class="absolute bottom-2 left-1/2 -translate-x-1/2 w-2/3 max-w-70 h-2.5 bg-stone-900/10 rounded-full blur-md animate-shadow"></div>
  </div>

  <!-- BOTÓN MOBILE: Se muestra SOLO en celulares (block md:hidden) al final de la grilla -->
  <div class="pt-6 pb-8 px-8 text-center w-full block md:hidden">
    <a 
      href="https://wa.me." 
      class="relative inline-flex items-center justify-center bg-brand-titulos text-white px-8 py-4 rounded-2xl w-full max-w-xs
             font-bold text-base tracking-wide font-['Outfit',sans-serif]
             shadow-[0_4px_0_0_#00335c,0_10px_20px_rgba(0,75,135,0.2)]
             border-t border-white/20
             transition-all duration-150 ease-out"
    >
      <span class="absolute inset-0 bg-linear-to-b from-white/12 to-transparent rounded-2xl pointer-events-none"></span>
      <span class="relative z-10 flex items-center justify-center gap-2">
        Consultar Reparto por WhatsApp 
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-white shrink-0">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
        </svg>
      </span>
    </a>
  </div>

</section>
