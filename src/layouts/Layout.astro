---
// Layout global para Muzzarellas El Guri - Configuración SEO B2B Neutra
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = "Muzzarella El Guri | Fábrica de Queso Muzzarella Mayorista" } = Astro.props;
const description = "Muzzarella El Guri: Venta directa de fábrica para pizzerías y comercios gastronómicos desde 10 kg en Capital, AMBA y Costa Atlántica.";
const siteUrl = "https://mozzarellas-el-guri.vercel.app/"; // Cambiar por el dominio final
const ogImage = "/images/og-share-el-guri.jpg"; // Imagen que se mostrará en WhatsApp
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Estándar -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta name="google-site-verification" content="ux_I5I851Vt-46xdAc04ely8MfkZz-6gE4qB9hvQaNc" />

		<!-- Open Graph / WhatsApp / Facebook (SEO Neutro y Comercial) -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:title" content="Muzzarella El Guri | Distribución Mayorista" />
		<meta property="og:description" content="Muzzarella Mayorista. Quesos directo de fábrica para su comercio. Envíos programados en AMBA, Capital y la Costa. Envíos desde 10 kg." />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/jpeg" />

		<!-- Fuentes de Google Fonts (Tipografía Outfit: Redondeada, Moderna y Limpia) -->
		<link rel="preconnect" href="https://googleapis.com">
		<link rel="preconnect" href="https://gstatic.com" crossorigin>
		<link href="https://googleapis.com/css2?family=Outfit:wght@300;400;600;800;900&display=swap" rel="stylesheet">
	</head>
	<body class="bg-brand-fondo font-['Outfit',sans-serif] min-h-screen text-stone-900 selection:bg-brand-azul/10 selection:text-brand-azul antialiased">
		
		<slot />

<!-- Eliminar Badge de Netlify dinámicamente -->
<script is:inline>
  function removeNetlifyBadge() {
    const wrap = document.querySelector('.nl-wrap');
    const badge = document.getElementById('nl-badge');
    const card = document.getElementById('nl-card');

    if (wrap) wrap.remove();
    if (badge) badge.remove();
    if (card) card.remove();
  }

  // Ejecutar inmediatamente cuando carga el DOM
  document.addEventListener('DOMContentLoaded', removeNetlifyBadge);

  // Observador por si Netlify lo inyecta unos milisegundos después
  const observer = new MutationObserver(() => {
    if (document.querySelector('.nl-wrap') || document.getElementById('nl-badge')) {
      removeNetlifyBadge();
    }
  });

  observer.observe(document.body, { childList: true, subtree: true });
</script>


	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
